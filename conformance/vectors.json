{
  "meta": {
    "protocol": "EACP",
    "protocol_version": 1,
    "header_size": 48,
    "byte_order": "big-endian (network order)",
    "header_struct": ">2sBBHHQQQQII",
    "slot_layout": "payload = len(s0):u16 | s0 | len(s1):u32 | s1 | len(s2):u32 | s2 | len(s3):u32 | s3  (s0=utf8 verb, s1=json invocation, s2=9-byte token_budget:u32/timeout_ms:u32/max_depth_hops:u8, s3=4-byte session_handle:u32 + 64-byte Ed25519 signature)",
    "signing_domain": "Ed25519 signature covers the 48-byte header (with FLAG_SIGNED set and payload_len = len(slots 0..2) + 64) followed by slots 0..2 and the 4-byte session_handle prefix of slot 3 (signature bytes excluded). See frame.get_signed_bytes().",
    "compression": "If FLAG_COMPRESSED is set, the payload section is a zlib stream of the slot block described above (zlib level 6 in the reference implementation; decompression is level-agnostic).",
    "limits": {
      "max_payload_size_for_negative_vectors": 4096
    },
    "note": "A conforming implementation MUST: (a) parse each positive 'frame_hex' into exactly the listed fields; (b) re-encode its own frames to the same bytes; (c) verify Ed25519 signatures over the documented signing domain; (d) reject every negative vector with the listed error."
  },
